# ---------- 参数 ----------

def parse(argv):
    urls, listfiles, out, psel, force, delay = [], [], None, None, False, 1.0
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-f", "--file"):
            if i + 1 >= len(argv):
                die("❌ -f 后面要跟列表文件")
            listfiles.append(argv[i + 1])
            i += 2
        elif a in ("-o", "--out"):
            if i + 1 >= len(argv):
                die("❌ -o 后面要跟目录")
            out = os.path.expanduser(argv[i + 1])
            i += 2
        elif a in ("-p", "--page"):
            if i + 1 >= len(argv):
                die("❌ -p 后面要跟分P序号")
            psel = argv[i + 1]
            i += 2
        elif a in ("--force", "-F"):
            force = True
            i += 1
        elif a == "--delay":
            if i + 1 >= len(argv):
                die("❌ --delay 后面要跟秒数")
            try:
                delay = float(argv[i + 1])
            except ValueError:
                die(f"❌ --delay 要写数字，收到：{argv[i + 1]}")
            i += 2
        elif a.startswith("-"):
            die(f"❌ 不认识的选项: {a}（敲 bili help 看全部用法）")
        else:
            path = os.path.expanduser(a)
            if path.lower().endswith((".txt", ".list")) and os.path.isfile(path):
                listfiles.append(path)
            else:
                urls.append(a)
            i += 1
    for listfile in listfiles:
        if not os.path.isfile(listfile):
            die(f"❌ 找不到列表文件: {listfile}")
        with open(listfile, encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip().lstrip("\ufeff")
                if line and not line.startswith("#"):
                    urls.append(line)
    return urls, out, psel, force, delay


def page_of(arg):
    m = re.search(r"[?&]p=(\d+)", arg)
    return m.group(1) if m else None


# b23.tv、bili2233.cn：手机 App 分享出来的短链
SHORT = re.compile(r"https?://(?:b23\.tv|bili2233\.cn)/[0-9A-Za-z]+", re.I)


def resolve_url(arg):
    """短链跟一次跳转，拿到真正的视频地址；其他链接原样返回。"""
    m = SHORT.search(arg)
    if not m:
        return arg
    req = urllib.request.Request(m.group(0), headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=15) as r:
        return r.geturl() or arg


def targets(arg):
    m = re.search(r"(BV[0-9A-Za-z]{10})", arg)
    if m:
        return {"bvid": m.group(1)}
    m = re.search(r"(?:^|[^0-9])a?[vV]?(\d{3,})(?:$|[?&#])", arg)
    if m:
        return {"aid": m.group(1)}
    if arg.isdigit():
        return {"aid": arg}
    return None


# ---------- 取数据 ----------

def video(idpair):
    url = "https://api.bilibili.com/x/web-interface/view?" + urllib.parse.urlencode(idpair)
    d = http_json(url)
    if d.get("code") != 0:
        raise RuntimeError(f"接口返回 {d.get('code')}: {d.get('message')}")
    v = d["data"]
    return {
        "aid": v["aid"],
        "bvid": v.get("bvid"),
        "title": v["title"],
        "up": v["owner"]["name"],
        "pubdate": v.get("pubdate") or 0,
        "duration": v.get("duration") or 0,
        "pages": v["pages"],
    }


def subtitles(aid, cid):
    d = http_json(f"https://api.bilibili.com/x/player/wbi/v2?aid={aid}&cid={cid}")
    if d.get("code") != 0:
        raise RuntimeError(f"接口返回 {d.get('code')}: {d.get('message')}")
    return ((d.get("data") or {}).get("subtitle") or {}).get("subtitles") or []


def pick(subs):
    """只取一版：中文原字幕 > 中文 AI 字幕 > 其他语言原字幕 > 其他语言 AI 字幕。"""
    cn = ("zh-CN", "zh-Hans", "zh-Hant", "zh-HK", "zh-TW", "ai-zh")
    ai = lambda s: str(s.get("lan", "")).startswith("ai")
    for test in (lambda s: s.get("lan") in cn and not ai(s),
                 lambda s: s.get("lan") in cn,
                 lambda s: not ai(s),
                 lambda s: True):
        for s in subs:
            if test(s):
                return s
    return None


def body_of(sub):
    u = sub.get("subtitle_url") or ""
    if u.startswith("//"):
        u = "https:" + u
    if not u:
        raise RuntimeError("字幕地址是空的")
    return http_json(u).get("body") or []


# ---------- 时间与校验 ----------

def proc_ts(t):
    t = int(float(t))
    return f"{t // 60:02d}:{t % 60:02d}"


def clock(sec):
    sec = int(sec)
    if sec >= 3600:
        return f"{sec // 3600}:{sec % 3600 // 60:02d}:{sec % 60:02d}"
    return f"{sec // 60:02d}:{sec % 60:02d}"


def check(body, duration):
    """返回 (级别, 说明)；级别 None 表示没问题。"""
    if not body:
        return "fail", "一条字幕都没有"
    try:
        last = max(float(x.get("to", 0)) for x in body)
    except (TypeError, ValueError):
        return "fail", "字幕时间戳格式不对"
    if not duration:
        return None, None
    if last > duration + 120:
        return "fail", f"字幕结尾 {proc_ts(last)} 超过视频长度 {proc_ts(duration)}，数据异常"
    gap = duration - last
    if gap > max(20, duration * 0.05):
        return "fail", f"只到 {proc_ts(last)}，视频长 {proc_ts(duration)}，判为被截断"
    if gap > 10:
        return "warn", f"比视频短 {int(gap)} 秒（片尾没人声时属正常）"
    return None, None


# ---------- 文件名 ----------

# 文件名最多留标题前 10 个字，超出的用省略号
NAME_LIMIT = 10


def short_name(title):
    """文件名：取标题前 10 个字，超出的用省略号收尾。"""
    name = clean(title, 500)
    if len(name) > NAME_LIMIT:
        return name[:NAME_LIMIT] + "…"
    return name


def _join(a, b):
    if a and b and a[-1].isascii() and a[-1].isalnum() and b[0].isascii() and b[0].isalnum():
        return a + " " + b
    return a + b


def to_txt(body, meta):
    """纯文本：开头写元数据（给 AI 认人、认出处），正文按停顿合并成段落。"""
    paras, cur, prev_end = [], "", None
    PARA_MAX = 200          # AI 字幕常常整段没有标点，只能按长度断段
    for x in body:
        text = str(x.get("content", "")).replace("\r", " ").strip()
        if not text:
            continue
        f, to = float(x.get("from", 0)), float(x.get("to", 0))
        if cur and prev_end is not None and f - prev_end > 1.2:
            paras.append(cur)
            cur = ""
        cur = _join(cur, text)
        prev_end = to
        if len(cur) >= PARA_MAX or text[-1:] in "。！？…":
            paras.append(cur)
            cur = ""
    if cur:
        paras.append(cur)

    head = [
        f"# {meta['title']}",
        "",
        f"- UP 主：{meta['up']}",
        f"- 链接：{meta['url']}",
        f"- 发布时间：{meta['pub']}",
        f"- 视频时长：{meta['dur']}",
        f"- 字幕类型：{meta['kind']}（{meta['lan']}），共 {len(body)} 条",
        f"- 导出时间：{datetime.now():%Y-%m-%d %H:%M}",
        f"- 工具：bili-sub {VERSION}",
        "",
        "## 字幕正文",
        "",
    ]
    return "\n".join(head) + "\n\n".join(paras) + "\n"


def existing(path, url):
    """看看这个视频是不是已经下过了。

    same    = .txt 在，且里面记的链接就是它
    other   = 同名 .txt 属于别的视频
    None    = 没下过
    """
    if not os.path.exists(path):
        return None
    try:
        with open(path, encoding="utf-8") as f:
            head = f.read(800)
    except OSError:
        return None
    return "same" if f"- 链接：{url}" in head else "other"


# ---------- 落盘 ----------

BAD = re.compile(r'[\\/:*?"<>|\r\n\t]')


def clean(name, limit=60):
    name = BAD.sub("_", name)
    name = re.sub(r"\s+", " ", name).strip().strip(".")
    return name[:limit] or "未命名"


def save_text(path, text):
    """先写临时文件再改名：要么写完整，要么什么都不留。"""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".part"
    try:
        with open(tmp, "w", encoding="utf-8", newline="\n") as f:
            f.write(text)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            try:
                os.remove(tmp)
            except OSError:
                pass


# ---------- 子命令 ----------

def do_status(verbose=False):
    print(f"bili-sub {VERSION}\n")
    ck = cookie()
    if not ck:
        print("登录状态：❌ 还没设置 cookie（只影响原字幕和受限视频）")
        print("            运行 bili setcookie 设置\n")
        code = 0
    else:
        try:
            d = http_json("https://api.bilibili.com/x/web-interface/nav")
            if (d.get("data") or {}).get("isLogin"):
                who = f"（账号 {d['data'].get('uname') or '未知'}）" if verbose else ""
                print(f"登录状态：✅ 有效{who}\n")
                code = 0
            else:
                print("登录状态：❌ 已失效（过期、退出登录或改了密码）")
                print("            运行 bili setcookie 重新设置\n")
                code = 1
        except Exception as e:
            print(f"登录状态：⚠️ 连不上 B 站，判断不了（{e}）\n")
            code = 0

    out = load_config()["out"]
    body = os.path.realpath(__file__)
    cmd = shutil.which("bili")
    print(f"程序位置：{pretty(body)}")
    if cmd and os.path.realpath(cmd) == body:
        print(f"命令入口：{pretty(cmd)}\n")
    elif cmd:
        print(f"命令入口：⚠️ PATH 里先找到的是另一个 bili：{pretty(cmd)}\n")
    else:
        print("命令入口：（没在 PATH 里找到 bili，重开终端或 source 一下 shell 配置）\n")
    print(f"输出目录：{pretty(out)}")
    print(f"          所有字幕都进这里，每个 UP 主一个子文件夹，例如 {pretty(out)}/<UP主名>/")
    print(f"          每个视频一个 .txt：<标题>.txt，标题取前 10 个字\n")

    print("卸载：")
    print(f"  1. rm -r {shell_path(BASE)}")
    print("       ← cookie 和输出目录设置")
    print(f"  2. rm {shell_path(body)}")
    print("       ← 程序本体，就一个文件")
    def same_file(a, b):
        try:
            sa, sb = os.stat(a), os.stat(b)
            return (sa.st_dev, sa.st_ino) == (sb.st_dev, sb.st_ino)
        except OSError:
            return False

    extra = []
    for p in (os.path.abspath(sys.argv[0]), shutil.which("bili")):
        if not p:
            continue
        ap = os.path.abspath(p)
        if ap == body or ap in extra:
            continue
        # 只列“指向本体的软链”；PATH 里别处装的另一个 bili 不归我们管
        if os.path.islink(ap) and os.path.realpath(ap) == body:
            extra.append(ap)
    for i, p in enumerate(extra, 3):
        print(f"  {i}. rm {shell_path(p)}")
        print("       ← 指向它的快捷方式（软链），删了不影响别处")
    for rc in (os.path.expanduser("~/.zshrc"), os.path.expanduser("~/.bash_profile"),
               os.path.expanduser("~/.bashrc"), os.path.expanduser("~/.profile"),
               os.path.expanduser("~/.config/fish/config.fish")):
        try:
            if "# >>> bili-sub >>>" not in open(rc, encoding="utf-8", errors="replace").read():
                continue
        except OSError:
            continue
        flag = "-i ''" if sys.platform == "darwin" else "-i"
        print(f"  {3 + len(extra)}. sed {flag} '/# >>> bili-sub >>>/,/# <<< bili-sub <<</d' {shell_path(rc)}")
        print(f"       ← 从 {rc.replace(os.path.expanduser('~'), '~')} 里删掉 PATH 配置")
        break
    print(f"  字幕文件在 {pretty(out)} 里，那是你自己下的，删不删随你。")
    print("\n平时只写 .txt；设置 cookie 或改输出目录时，才会写上面第 1 项的配置。")
    return code


def do_setcookie():
    if cookie():
        print(f"⚠️  已设置过 cookie（{pretty(COOKIE_FILE)}），本次直接覆盖。")
    print("""怎么拿 cookie（Chrome，电脑版）：
  1. 打开 bilibili.com，确认右上角是你自己的头像
  2. 按 Cmd + Option + I 打开开发者工具（Mac 上 F12 是音量键）
  3. 顶部选「应用 / Application」→ 左侧「Cookie」→
     https://www.bilibili.com → 找到 SESSDATA → 双击 Value 全选复制
  4. 粘到下面，回车结束（只粘值也行，会自动补上 SESSDATA=）""")
    print("> ", end="", flush=True)
    line = sys.stdin.readline()
    if not line:
        print("\n❌ 没读到内容，未做任何改动。")
        return 1
    line = line.strip().strip('"').strip("'")
    if not line:
        print("❌ 没读到内容，未做任何改动。")
        return 1
    if "SESSDATA=" not in line:
        if "=" in line:
            print("❌ 有等号但没找到 SESSDATA=，未做任何改动。")
            return 1
        line = "SESSDATA=" + line
    os.makedirs(BASE, exist_ok=True)
    with open(COOKIE_FILE, "w", encoding="utf-8") as f:
        f.write(line)
    try:
        os.chmod(COOKIE_FILE, 0o600)
    except OSError:
        pass
    print(f"✅ 已保存到 {pretty(COOKIE_FILE)}")
    return do_status()


def do_setout(argv):
    cfg = load_config()
    if not argv:
        print(f"当前输出目录：{pretty(cfg['out'])}")
        print('改的话：bili setout "/绝对/路径/字幕"')
        return 0
    raw = " ".join(argv).strip().strip('"').strip("'")
    if not raw:
        print('❌ 没读到路径。用法：bili setout "/绝对/路径/字幕"')
        return 1
    path = os.path.expanduser(raw)
    if not os.path.isabs(path):
        print(f"❌ 这不是绝对路径：{raw}")
        print("   要写完整的、从根目录开始的路径，并用双引号括起来，例如：")
        print('   bili setout "/Users/你的名字/Movies/字幕"')
        return 1
    path = os.path.normpath(path)
    try:
        os.makedirs(path, exist_ok=True)
    except OSError as e:
        print(f"❌ 这个目录建不出来：{pretty(path)}（{e}）")
        return 1
    if not os.access(path, os.W_OK):
        print(f"❌ 这个目录不可写：{pretty(path)}")
        return 1
    cfg["out"] = path
    save_config(cfg)
    print(f"✅ 输出目录已设为：{pretty(path)}")
    print(f"   以后的字幕存到：{pretty(path)}/<UP主>/<标题>.txt")
    return 0


# ---------- 主流程 ----------

def run(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        usage()
        return 0
    if argv[0] in ("-v", "--version", "version"):
        print(f"bili-sub {VERSION}")
        return 0
    if argv[0] == "status":
        return do_status("--verbose" in argv[1:] or "-V" in argv[1:])
    if argv[0] == "setcookie":
        return do_setcookie()
    if argv[0] == "setout":
        return do_setout(argv[1:])

    urls, out, psel, force, delay = parse(argv)
    if not urls:
        usage()
        return 2
    out = out or load_config()["out"]
    seen = set()
    urls = [u for u in urls if not (u in seen or seen.add(u))]
    if not cookie():
        print("⚠️  还没登录，先按未登录状态试（要登录就跑 bili setcookie）")

    ok = fail = skip = 0
    total = len(urls)
    for n, u in enumerate(urls, 1):
        if n > 1 and delay > 0:
            # 固定间隔太机械，抖一下；风控不认时间表
            time.sleep(delay * random.uniform(0.85, 1.25))
        print(f"── [{n}/{total}] {u}" if total > 1 else f"── {u}")
        try:
            real = resolve_url(u)
        except Exception as e:
            print(f"   ✗ 这个短链接打不开：{e}")
            fail += 1
            continue
        pair = targets(real)
        if not pair:
            if real != u:
                print("   ✗ 这个短链接没指向视频页")
            else:
                print("   ✗ 认不出这是哪个视频（要 BV 号、av 号或视频页网址；番剧、直播不支持）")
            fail += 1
            continue
        try:
            v = video(pair)
        except Exception as e:
            print(f"   ✗ 拿不到视频信息：{e}")
            fail += 1
            continue
        want = psel if psel is not None else page_of(real)
        pages = v["pages"]
        if want and want != "all":
            pages = [p for p in pages if str(p.get("page")) == str(want)]
            if not pages:
                print(f"   ✗ 这个视频没有第 {want} 个分P")
                fail += 1
                continue
        multi = len(v["pages"]) > 1
        for p in pages:
            label = f"P{p['page']} {p.get('part') or ''} " if multi else ""
            name = short_name(v["title"])
            if multi:
                name += f".p{p['page']:02d}"
            try:
                subs = subtitles(v["aid"], p["cid"])
            except Exception as e:
                print(f"   ✗ {label}拿不到字幕列表：{e}")
                fail += 1
                continue
            sub = pick(subs)
            if not sub:
                if cookie():
                    print(f"   ✗ {label}这个视频没有字幕（原字幕、AI 字幕都没有）")
                else:
                    print(f"   ✗ {label}没取到字幕。没登录时不少视频看不到字幕，先 bili setcookie 再试")
                fail += 1
                continue
            lan = sub.get("lan") or "unknown"
            kind = "AI 字幕" if str(lan).startswith("ai") else "原字幕"

            url = f"https://www.bilibili.com/video/{v['bvid'] or 'av' + str(v['aid'])}"
            if multi:
                url += f"?p={p['page']}"
            title = f"{v['title']} P{p['page']} {p.get('part') or ''}".strip() if multi else v["title"]
            base = os.path.join(out, clean(v["up"]), name)
            path = base + ".txt"
            state = None if force else existing(path, url)
            if state == "same":
                print(f"   ↷ {label}已经下过了，跳过（想重下加 --force）")
                skip += 1
                continue
            if state == "other":
                path = base + f".{v['bvid'] or v['aid']}.txt"
                print(f"   ⚠️  同名文件属于别的视频，这次另存为 {os.path.basename(path)}")

            try:
                body = body_of(sub)
            except Exception as e:
                print(f"   ✗ {label}字幕内容下载失败：{e}")
                fail += 1
                continue
            level, note = check(body, p.get("duration") or v["duration"])
            if level == "fail":
                print(f"   ✗ {label}{kind}不可用：{note}")
                fail += 1
                continue
            if level == "warn":
                print(f"   ⚠️  {label}{note}")

            meta = {
                "title": title,
                "up": v["up"],
                "url": url,
                "pub": datetime.fromtimestamp(v["pubdate"]).strftime("%Y-%m-%d %H:%M") if v["pubdate"] else "未知",
                "dur": clock(p.get("duration") or v["duration"]),
                "kind": kind,
                "lan": lan,
            }
            try:
                save_text(path, to_txt(body, meta))
            except OSError as e:
                print(f"   ✗ {label}写文件失败：{e}")
                fail += 1
                continue
            print(f"   ✓ {label}{kind} {len(body)} 条 → {pretty(path)}")
            ok += 1

    print(f"==== 完成：新下 {ok} 个，跳过 {skip} 个，失败 {fail} 个 ====")
    print(f"==== 位置：{pretty(out)} ====")
    return 0 if fail == 0 else 1


if __name__ == "__main__":
    try:
        sys.exit(run(sys.argv[1:]))
    except KeyboardInterrupt:
        print("\n已中断")
        sys.exit(130)
