# ---------- 参数 ----------

def parse(argv):
    urls, listfiles, out, psel, force = [], [], None, None, False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-f", "--file"):
            if i + 1 >= len(argv):
                die("❌ -f 后面要跟列表文件")
            listfiles.append(argv[i + 1])
            i += 2
        elif a in ("-o", "--out"):
            if i + 1 >= len(argv):
                die("❌ -o 后面要跟目录")
            out = os.path.expanduser(argv[i + 1])
            i += 2
        elif a in ("-p", "--page"):
            if i + 1 >= len(argv):
                die("❌ -p 后面要跟分P序号")
            psel = argv[i + 1]
            i += 2
        elif a in ("--force", "-F"):
            force = True
            i += 1
        elif a.startswith("-"):
            die(f"❌ 不认识的选项: {a}（敲 bili help 看全部用法）")
        else:
            path = os.path.expanduser(a)
            if path.lower().endswith((".txt", ".list")) and os.path.isfile(path):
                listfiles.append(path)
            else:
                urls.append(a)
            i += 1
    for listfile in listfiles:
        if not os.path.isfile(listfile):
            die(f"❌ 找不到列表文件: {listfile}")
        with open(listfile, encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip().lstrip("\ufeff")
                if line and not line.startswith("#"):
                    urls.append(line)
    return urls, out, psel, force


def page_of(arg):
    m = re.search(r"[?&]p=(\d+)", arg)
    return m.group(1) if m else None


def targets(arg):
    m = re.search(r"(BV[0-9A-Za-z]{10})", arg)
    if m:
        return {"bvid": m.group(1)}
    m = re.search(r"(?:^|[^0-9])a?[vV]?(\d{3,})(?:$|[?&#])", arg)
    if m:
        return {"aid": m.group(1)}
    if arg.isdigit():
        return {"aid": arg}
    return None


# ---------- 取数据 ----------

def video(idpair):
    url = "https://api.bilibili.com/x/web-interface/view?" + urllib.parse.urlencode(idpair)
    d = http_json(url)
    if d.get("code") != 0:
        raise RuntimeError(f"接口返回 {d.get('code')}: {d.get('message')}")
    v = d["data"]
    return {
        "aid": v["aid"],
        "bvid": v.get("bvid"),
        "title": v["title"],
        "up": v["owner"]["name"],
        "pubdate": v.get("pubdate") or 0,
        "duration": v.get("duration") or 0,
        "pages": v["pages"],
    }


def subtitles(aid, cid):
    d = http_json(f"https://api.bilibili.com/x/player/wbi/v2?aid={aid}&cid={cid}")
    if d.get("code") != 0:
        raise RuntimeError(f"接口返回 {d.get('code')}: {d.get('message')}")
    return ((d.get("data") or {}).get("subtitle") or {}).get("subtitles") or []


def pick(subs):
    """只取一版：中文原字幕 > 中文 AI 字幕 > 其他语言原字幕 > 其他语言 AI 字幕。"""
    cn = ("zh-CN", "zh-Hans", "zh-Hant", "zh-HK", "zh-TW", "ai-zh")
    ai = lambda s: str(s.get("lan", "")).startswith("ai")
    for test in (lambda s: s.get("lan") in cn and not ai(s),
                 lambda s: s.get("lan") in cn,
                 lambda s: not ai(s),
                 lambda s: True):
        for s in subs:
            if test(s):
                return s
    return None


def body_of(sub):
    u = sub.get("subtitle_url") or ""
    if u.startswith("//"):
        u = "https:" + u
    if not u:
        raise RuntimeError("字幕地址是空的")
    return http_json(u).get("body") or []


# ---------- 时间与校验 ----------

def ts(t):
    ms = int(round(float(t) * 1000))
    h, ms = divmod(ms, 3600000)
    m, ms = divmod(ms, 60000)
    s, ms = divmod(ms, 1000)
    return f"{h:02d}:{m:02d}:{s:02d},{ms:03d}"


def proc_ts(t):
    t = int(float(t))
    return f"{t // 60:02d}:{t % 60:02d}"


def clock(sec):
    sec = int(sec)
    if sec >= 3600:
        return f"{sec // 3600}:{sec % 3600 // 60:02d}:{sec % 60:02d}"
    return f"{sec // 60:02d}:{sec % 60:02d}"


def check(body, duration):
    """返回 (级别, 说明)；级别 None 表示没问题。"""
    if not body:
        return "fail", "一条字幕都没有"
    try:
        last = max(float(x.get("to", 0)) for x in body)
    except (TypeError, ValueError):
        return "fail", "字幕时间戳格式不对"
    if not duration:
        return None, None
    if last > duration + 120:
        return "fail", f"字幕结尾 {proc_ts(last)} 超过视频长度 {proc_ts(duration)}，数据异常"
    gap = duration - last
    if gap > max(20, duration * 0.05):
        return "fail", f"只到 {proc_ts(last)}，视频长 {proc_ts(duration)}，判为被截断"
    if gap > 10:
        return "warn", f"比视频短 {int(gap)} 秒（片尾没人声时属正常）"
    return None, None


# ---------- 生成两种格式 ----------

def to_srt(body):
    blocks = []
    for i, x in enumerate(body, 1):
        text = str(x.get("content", "")).replace("\r", " ").strip()
        blocks.append(f"{i}\n{ts(x.get('from', 0))} --> {ts(x.get('to', 0))}\n{text}\n")
    return "\n".join(blocks)


def _join(a, b):
    if a and b and a[-1].isascii() and a[-1].isalnum() and b[0].isascii() and b[0].isalnum():
        return a + " " + b
    return a + b


def to_txt(body, meta):
    """纯文本：开头写元数据（给 AI 认人、认出处），正文按停顿合并成段落。"""
    paras, cur, prev_end = [], "", None
    PARA_MAX = 200          # AI 字幕常常整段没有标点，只能按长度断段
    for x in body:
        text = str(x.get("content", "")).replace("\r", " ").strip()
        if not text:
            continue
        f, to = float(x.get("from", 0)), float(x.get("to", 0))
        if cur and prev_end is not None and f - prev_end > 1.2:
            paras.append(cur)
            cur = ""
        cur = _join(cur, text)
        prev_end = to
        if len(cur) >= PARA_MAX or text[-1:] in "。！？…":
            paras.append(cur)
            cur = ""
    if cur:
        paras.append(cur)

    head = [
        f"# {meta['title']}",
        "",
        f"- UP 主：{meta['up']}",
        f"- 链接：{meta['url']}",
        f"- 发布时间：{meta['pub']}",
        f"- 视频时长：{meta['dur']}",
        f"- 字幕类型：{meta['kind']}（{meta['lan']}），共 {len(body)} 条",
        f"- 导出时间：{datetime.now():%Y-%m-%d %H:%M}",
        f"- 工具：bili-sub {VERSION}",
        "",
        "## 字幕正文",
        "",
    ]
    return "\n".join(head) + "\n\n".join(paras) + "\n"


def existing(base, url):
    """看看这个视频是不是已经下过了。

    same    = 文件都在，且 .txt 里记的链接就是它
    other   = 同名文件存在，但属于别的视频
    partial = 只有 .srt，缺 .txt
    None    = 没下过
    """
    srt, txt = base + ".srt", base + ".txt"
    if not os.path.exists(srt):
        return None
    if not os.path.exists(txt):
        return "partial"
    try:
        with open(txt, encoding="utf-8") as f:
            head = f.read(800)
    except OSError:
        return None
    return "same" if f"- 链接：{url}" in head else "other"


# ---------- 落盘 ----------

BAD = re.compile(r'[\\/:*?"<>|\r\n\t]')


def clean(name, limit=60):
    name = BAD.sub("_", name)
    name = re.sub(r"\s+", " ", name).strip().strip(".")
    return name[:limit] or "未命名"


def save_pair(items):
    """把 (路径, 内容) 全写成临时文件，再一起改名：要么两个都在，要么都不留。"""
    tmps = []
    try:
        for path, text in items:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            tmp = path + ".part"
            with open(tmp, "w", encoding="utf-8", newline="\n") as f:
                f.write(text)
            tmps.append((tmp, path))
        for tmp, path in tmps:
            os.replace(tmp, path)
    finally:
        for tmp, _ in tmps:
            if os.path.exists(tmp):
                try:
                    os.remove(tmp)
                except OSError:
                    pass


# ---------- 子命令 ----------

def do_status(verbose=False):
    print(f"bili-sub {VERSION}\n")
    ck = cookie()
    if not ck:
        print("登录状态：❌ 还没设置 cookie（只影响原字幕和受限视频）")
        print("            运行 bili setcookie 设置\n")
        code = 0
    else:
        try:
            d = http_json("https://api.bilibili.com/x/web-interface/nav")
            if (d.get("data") or {}).get("isLogin"):
                who = f"（账号 {d['data'].get('uname') or '未知'}）" if verbose else ""
                print(f"登录状态：✅ 有效{who}\n")
                code = 0
            else:
                print("登录状态：❌ 已失效（过期、退出登录或改了密码）")
                print("            运行 bili setcookie 重新设置\n")
                code = 1
        except Exception as e:
            print(f"登录状态：⚠️ 连不上 B 站，判断不了（{e}）\n")
            code = 0

    out = load_config()["out"]
    body = os.path.realpath(__file__)
    cmd = shutil.which("bili") or sys.argv[0]
    print(f"程序位置：{pretty(body)}")
    print(f"命令入口：{pretty(cmd)}\n")
    print(f"输出目录：{pretty(out)}")
    print(f"          所有字幕都进这里，每个 UP 主一个子文件夹，例如 {pretty(out)}/<UP主名>/")
    print(f"          每个视频两个文件：<标题>.<语言>.srt 和 <标题>.<语言>.txt\n")

    print("卸载：")
    print(f"  1. rm -r {shell_path(BASE)}")
    print("       ← cookie 和输出目录设置")
    print(f"  2. rm {shell_path(body)}")
    print("       ← 程序本体，就一个文件")
    if os.path.realpath(cmd) != body:
        print(f"  3. rm {shell_path(cmd)}")
        print("       ← 指向它的软链")
    print(f"  字幕文件在 {pretty(out)} 里，那是你自己下的，删不删随你。")
    print("\n平时只写 .srt 和 .txt；设置 cookie 或改输出目录时，才会写上面第 1 项的配置。")
    return code


def do_setcookie():
    if cookie():
        print(f"⚠️  已设置过 cookie（{COOKIE_FILE}），本次直接覆盖。")
    print("""怎么拿 cookie（Chrome，电脑版）：
  1. 打开 bilibili.com，确认右上角是你自己的头像
  2. 按 Cmd + Option + I 打开开发者工具（Mac 上 F12 是音量键）
  3. 顶部选「应用 / Application」→ 左侧「Cookie」→
     https://www.bilibili.com → 找到 SESSDATA → 双击 Value 全选复制
  4. 粘到下面，回车结束（只粘值也行，会自动补上 SESSDATA=）""")
    print("> ", end="", flush=True)
    line = sys.stdin.readline()
    if not line:
        print("\n❌ 没读到内容，未做任何改动。")
        return 1
    line = line.strip().strip('"').strip("'")
    if not line:
        print("❌ 没读到内容，未做任何改动。")
        return 1
    if "SESSDATA=" not in line:
        if "=" in line:
            print("❌ 有等号但没找到 SESSDATA=，未做任何改动。")
            return 1
        line = "SESSDATA=" + line
    os.makedirs(BASE, exist_ok=True)
    with open(COOKIE_FILE, "w", encoding="utf-8") as f:
        f.write(line)
    try:
        os.chmod(COOKIE_FILE, 0o600)
    except OSError:
        pass
    print(f"✅ 已保存到 {COOKIE_FILE}")
    return do_status()


def do_setout(argv):
    cfg = load_config()
    if not argv:
        print(f"当前输出目录：{pretty(cfg['out'])}")
        print('改的话：bili setout "/绝对/路径/字幕"')
        return 0
    raw = " ".join(argv).strip().strip('"').strip("'")
    if not raw:
        print('❌ 没读到路径。用法：bili setout "/绝对/路径/字幕"')
        return 1
    path = os.path.expanduser(raw)
    if not os.path.isabs(path):
        print(f"❌ 这不是绝对路径：{raw}")
        print("   要写完整的、从根目录开始的路径，并用双引号括起来，例如：")
        print('   bili setout "/Users/你的名字/Movies/字幕"')
        return 1
    path = os.path.normpath(path)
    try:
        os.makedirs(path, exist_ok=True)
    except OSError as e:
        print(f"❌ 这个目录建不出来：{e}")
        return 1
    if not os.access(path, os.W_OK):
        print(f"❌ 这个目录不可写：{path}")
        return 1
    cfg["out"] = path
    save_config(cfg)
    print(f"✅ 输出目录已设为：{pretty(path)}")
    print(f"   以后的字幕存到：{pretty(path)}/<UP主>/<标题>.<语言>.srt")
    return 0


# ---------- 主流程 ----------

def run(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        usage()
        return 0
    if argv[0] in ("-v", "--version", "version"):
        print(f"bili-sub {VERSION}")
        return 0
    if argv[0] == "status":
        return do_status("--verbose" in argv[1:] or "-V" in argv[1:])
    if argv[0] == "setcookie":
        return do_setcookie()
    if argv[0] == "setout":
        return do_setout(argv[1:])

    urls, out, psel, force = parse(argv)
    if not urls:
        usage()
        return 2
    out = out or load_config()["out"]
    seen = set()
    urls = [u for u in urls if not (u in seen or seen.add(u))]
    if not cookie():
        print("⚠️  还没设置 cookie，先按未登录状态试（部分视频仍能拿到 AI 字幕）")

    ok = fail = skip = 0
    total = len(urls)
    for n, u in enumerate(urls, 1):
        print(f"── [{n}/{total}] {u}" if total > 1 else f"── {u}")
        pair = targets(u)
        if not pair:
            print("   ✗ 认不出这是哪个视频（要 BV 号、av 号或完整网址）")
            fail += 1
            continue
        try:
            v = video(pair)
        except Exception as e:
            print(f"   ✗ 拿不到视频信息：{e}")
            fail += 1
            continue
        want = psel if psel is not None else page_of(u)
        pages = v["pages"]
        if want and want != "all":
            pages = [p for p in pages if str(p.get("page")) == str(want)]
            if not pages:
                print(f"   ✗ 这个视频没有第 {want} 个分P")
                fail += 1
                continue
        multi = len(v["pages"]) > 1
        for p in pages:
            label = f"P{p['page']} {p.get('part') or ''} " if multi else ""
            name = clean(v["title"])
            if multi:
                name += f".p{p['page']:02d}"
            try:
                subs = subtitles(v["aid"], p["cid"])
            except Exception as e:
                print(f"   ✗ {label}拿不到字幕列表：{e}")
                fail += 1
                continue
            sub = pick(subs)
            if not sub:
                if cookie():
                    print(f"   ✗ {label}这个视频没有字幕（原字幕、AI 字幕都没有）")
                else:
                    print(f"   ✗ {label}没取到字幕。没登录时不少视频看不到字幕，先 bili setcookie 再试")
                fail += 1
                continue
            lan = sub.get("lan") or "unknown"
            kind = "AI 字幕" if str(lan).startswith("ai") else "原字幕"

            url = f"https://www.bilibili.com/video/{v['bvid'] or 'av' + str(v['aid'])}"
            if multi:
                url += f"?p={p['page']}"
            title = f"{v['title']} P{p['page']} {p.get('part') or ''}".strip() if multi else v["title"]
            base = os.path.join(out, clean(v["up"]), f"{name}.{lan}")
            state = None if force else existing(base, url)
            if state == "same":
                print(f"   ↷ {label}已经下过了，跳过（想重下加 --force）")
                skip += 1
                continue
            if state == "other":
                base += f".{v['bvid'] or v['aid']}"
                print(f"   ⚠️  同名文件属于别的视频，这次另存为 {os.path.basename(base)}.*")

            try:
                body = body_of(sub)
            except Exception as e:
                print(f"   ✗ {label}字幕内容下载失败：{e}")
                fail += 1
                continue
            level, note = check(body, p.get("duration") or v["duration"])
            if level == "fail":
                print(f"   ✗ {label}{kind}不可用：{note}")
                fail += 1
                continue
            if level == "warn":
                print(f"   ⚠️  {label}{note}")

            meta = {
                "title": title,
                "up": v["up"],
                "url": url,
                "pub": datetime.fromtimestamp(v["pubdate"]).strftime("%Y-%m-%d %H:%M") if v["pubdate"] else "未知",
                "dur": clock(p.get("duration") or v["duration"]),
                "kind": kind,
                "lan": lan,
            }
            try:
                save_pair([(base + ".srt", to_srt(body)), (base + ".txt", to_txt(body, meta))])
            except OSError as e:
                print(f"   ✗ {label}写文件失败：{e}")
                fail += 1
                continue
            print(f"   ✓ {label}{kind} {len(body)} 条 → {base}.srt / .txt")
            ok += 1

    print(f"==== 完成：新下 {ok} 个，跳过 {skip} 个，失败 {fail} 个 ====")
    print(f"==== 位置：{pretty(out)} ====")
    return 0 if fail == 0 else 1


if __name__ == "__main__":
    try:
        sys.exit(run(sys.argv[1:]))
    except KeyboardInterrupt:
        print("\n已中断")
        sys.exit(130)
